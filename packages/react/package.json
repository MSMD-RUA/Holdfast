{
  "name": "@holdfast/react",
  "version": "0.1.0",
  "description": "React bindings for HoldfastGate — HoldfastGuard component and useHoldfast hook.",
  "keywords": ["holdfast", "confirmation", "react", "hook", "gate", "ux", "deliberate"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "rollup -c",
    "dev":   "rollup -c --watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@holdfast/core": "workspace:*"
  },
  "devDependencies": {
    "rollup": "^4.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "react": "^18.0.0"
  },
  "sideEffects": false
}
