{
  "name": "holdfast",
  "private": true,
  "description": "Holdfast monorepo — behavioural confirmation engine for deliberate UI interactions.",
  "scripts": {
    "build":       "pnpm -r build",
    "dev":         "pnpm -r dev",
    "test":        "pnpm -r test",
    "clean":       "pnpm -r exec -- rm -rf dist",
